{
  "name": "chatcut-production-mirror",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "build": "node scripts/mirror.mjs",
    "mirror:full": "MIRROR_MEDIA_MODE=local node scripts/mirror.mjs",
    "verify:dist": "node scripts/verify-dist.mjs",
    "preview:qa": "node scripts/preview-qa.cjs",
    "ci:check": "npm test && npm run build && npm run verify:dist",
    "ci:predeploy": "npm test && npm run mirror:full && npm run verify:dist"
  }
}
